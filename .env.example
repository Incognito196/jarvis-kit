# ---- who this Jarvis is -----------------------------------------------------
JARVIS_NAME=Jarvis
# What it calls you out loud. Leave blank to keep it impersonal.
JARVIS_OWNER=

# ---- brain ------------------------------------------------------------------
# Path to the Claude Code CLI. Left unset, the bridge finds it on PATH.
# CLAUDE_BIN=/Users/you/.local/bin/claude
# Chat runs on the fast model; real work escalates to the middle one automatically.
JARVIS_FAST_MODEL=claude-haiku-4-5-20251001
JARVIS_MIDDLE_MODEL=claude-sonnet-5
# Set JARVIS_MODEL to pin ONE model and switch routing off entirely.
# JARVIS_MODEL=claude-sonnet-5
# Follow-up turns that stay escalated after a heavy turn.
JARVIS_STICKY_TURNS=2
# Extra words that should escalate to the better model — your own nouns, comma separated.
# JARVIS_ACT_WORDS=greenhouse,3d printer,garage

# Where the brain runs. This directory IS a security boundary: file tools can read
# anything under it, so do not point it at a folder full of secrets.
JARVIS_WORKDIR=~

# Sessions are rotated before they get slow. Continuity survives via the memory log.
JARVIS_MAX_TURNS=30
JARVIS_MAX_AGE_MIN=120
JARVIS_MEM_RECALL=14

# ---- voice ------------------------------------------------------------------
# edge    free Microsoft neural voice, online, cross-platform  (recommended)
# say     macOS built-in
# kokoro  offline neural, needs voices/kokoro-v1.0.onnx + ffmpeg
# piper   offline neural, needs a .onnx model + ffmpeg
# browser skip server-side TTS and let the browser speak
JARVIS_VOICE=edge
EDGE_VOICE=en-US-AndrewMultilingualNeural
# SAY_VOICE=Evan

# ---- network ----------------------------------------------------------------
JARVIS_PORT=8722
# Keep this on loopback. To reach it from your phone, front it with a private tunnel
# (Tailscale Serve, Cloudflare Tunnel, WireGuard) — do NOT bind it to 0.0.0.0.
JARVIS_BIND=127.0.0.1

# Written on first boot if missing. Anything holding this token can make this machine
# act. Treat it like a password.
# JARVIS_TOKEN=

# If you front the bridge with an identity-aware tunnel, list the logins allowed to
# drive the face, and the header your tunnel injects. Left blank, only requests that
# never passed through a proxy (i.e. from this machine) are trusted.
# JARVIS_ALLOWED_LOGINS=you@example.com
# JARVIS_IDENTITY_HEADER=Tailscale-User-Login

# ---- brain auth (headless) --------------------------------------------------
# A background service cannot read your login keychain, so an interactive `claude`
# login on your desktop may not carry over. If the bridge reports auth errors, create
# a long-lived token with `claude setup-token` and paste it here — the bridge passes it
# to the CLI through the environment.
# CLAUDE_CODE_OAUTH_TOKEN=
