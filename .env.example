# JARVIS secrets. Copy to .env, fill in, chmod 600. NEVER commit this file.
# install.sh does the copy + chmod for you.

# --- required ---------------------------------------------------------------
# Shared secret guarding /think, /speak, /think_stream. Anything that can reach the
# bridge port can otherwise run commands on this machine with no auth at all.
# Leave blank and the bridge generates one on first boot and writes it back here.
JARVIS_TOKEN=

# --- voice ------------------------------------------------------------------
# Which engine speaks: edge | say | kokoro | piper | elevenlabs
# "edge" (free Microsoft neural voices, needs internet) is the best default.
# "say"    = macOS built-in, offline, instant, robotic.
# "kokoro" / "piper" = offline neural, needs a model in voices/ (see README).
JARVIS_VOICE=edge
EDGE_VOICE=en-US-AndrewMultilingualNeural

# ElevenLabs — only if JARVIS_VOICE=elevenlabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- Telegram bridge (optional) ---------------------------------------------
# From @BotFather. Leave blank to skip the Telegram channel entirely.
TELEGRAM_BOT_TOKEN=

# --- brain tuning (all optional, sane defaults in bridge.py) ----------------
# Pin ONE model and disable routing:
# JARVIS_MODEL=claude-sonnet-5
# JARVIS_FAST_MODEL=claude-haiku-4-5-20251001
# JARVIS_MIDDLE_MODEL=claude-sonnet-5
# JARVIS_PORT=8722
# JARVIS_MAX_TURNS=30
# JARVIS_MAX_AGE_MIN=120
# JARVIS_MEM_RECALL=14
# CLAUDE_BIN=/Users/you/.local/bin/claude

# --- TV control (optional, tools/tv.sh) -------------------------------------
# TV_HOST=192.168.1.50:5555
